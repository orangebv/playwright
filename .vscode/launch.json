
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Playwright pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-s",
                "-v",
                "--tb=long",
                "tests/test_demo.py",
                "--headed"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "stopOnEntry": true
        }
    ]
}
